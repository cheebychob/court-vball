{
  "$schema": "https://raw.githubusercontent.com/cloudflare/workers-sdk/main/packages/wrangler/config-schema.json",
  "name": "court-sync",
  "main": "court-sync-worker.js",
  "compatibility_date": "2026-07-24",
  "keep_vars": true,

  // Copy this file to wrangler.jsonc only after replacing every required
  // existing-resource value. Deploying with new KV or R2 resources would
  // disconnect Court from its current sync, schedule, check-in, and photo data.
  "kv_namespaces": [
    { "binding": "COURT", "id": "REPLACE_WITH_COURT_KV_NAMESPACE_ID" },
    { "binding": "PUBLIC_SCHEDULES", "id": "REPLACE_WITH_PUBLIC_SCHEDULES_KV_NAMESPACE_ID" },
    { "binding": "CHECK_IN_SESSIONS", "id": "REPLACE_WITH_CHECK_IN_SESSIONS_KV_NAMESPACE_ID" }
  ],
  "r2_buckets": [
    { "binding": "PLAYER_PHOTOS", "bucket_name": "REPLACE_WITH_PRIVATE_PLAYER_PHOTOS_BUCKET_NAME" }
  ],
  "d1_databases": [
    {
      "binding": "EVENT_REGISTRATION_DB",
      "database_name": "court-event-registration",
      "database_id": "REPLACE_WITH_EVENT_REGISTRATION_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
